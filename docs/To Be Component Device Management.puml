@startuml
title "Диаграмма контейнера Управление устройствами приложения Smart Home To Be"

top to bottom direction

!include C4/C4_Component.puml

System_Boundary(SmartHomeApp, "Приложения использующие API") {
    System(WebApp, "WebApp")
}

System_Boundary(UserHome, "Дом пользователя") {
    System(SensorHeating, "Датчик отопления")
}


System_Boundary(Domain, "Управление устройствами умного дома") {
    System_Boundary(SubdomainManageDevice, "Управление устройствами") {
        Container_Boundary(ManageDeviceApi, "API") {
            Component("DeviceCommandController", "Управление устройствами", "SpringWeb Controller")
            Component("DeviceStateController", "Получение состояние", "SpringWeb Controller")
        }
        ContainerDb(ManageDeviceDb, "DB")
        ContainerQueue(ManageDeviceQueue, "Queue")
    }

    System_Boundary(SubdomainAdministration, "Администрирование") {
        Container(AdministrationApi, "Api")
        ContainerDb(AdministrationDb, "DB")
    }

    System_Boundary(TelemetrySystem, "Телеметрия") {
        Container(TelemetryApi, "Api")
    }
}



Rel(AdministrationDb, ManageDeviceDb, "Replication")
Rel(ManageDeviceQueue, ManageDeviceDb, "Read/Write")


Rel(DeviceCommandController, ManageDeviceQueue, "Добавляет команду в очередь")
Rel(DeviceStateController, TelemetryApi, "Запрашивает состояние устройства")

Rel(ManageDeviceQueue, SensorHeating, "Отправляет команду", "Датчику")
Rel(ManageDeviceQueue, TelemetryApi, "Отправить обновленное состояние устройства", "Состояние устройства")

Rel(WebApp, AdministrationApi, "Отправляет команду", "Для устройства")

@enduml

