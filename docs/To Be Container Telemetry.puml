@startuml
title "Диаграмма контейнера Телеметрия приложения Smart Home To Be"

top to bottom direction

!include C4/C4_Container.puml


System_Boundary(UserHome, "Дом пользователя") {
    System(SensorHeating, "Датчик отопления")
    System(SensorLight, "Датчик света на крыльце")
}

System_Boundary(Domain, "Управление устройствами умного дома") {
    Container_Boundary(SubdomainTelemetry, "Телеметрия") {
        Container(TelemetryApi, "API")
        ContainerDb(TelemetryDb, "DB")
        ContainerQueue(TelemetryQueue, "Queue")
    }

    Container_Boundary(SubdomainAdministration, "Администрирование") {
        ContainerDb(AdministrationDb, "DB")
    }

    Container_Boundary(ManageDeviceTelemetry, "Управление устройствами") {
        Container(ManageDeviceApi, "API")
    }
}


Rel(TelemetryApi, TelemetryDb, "Read\Write")
Rel(TelemetryApi, TelemetryQueue, "Add To", "Отложенная обработка")
Rel(TelemetryQueue, TelemetryDb, "Read")

Rel(SensorLight, TelemetryApi, "Отправляет данные", "Датчик")
Rel(TelemetryApi, SensorLight, "Запрашивает данные", "Датчик")

Rel(SensorHeating, TelemetryApi, "Отправляет данные", "Датчик")
Rel(TelemetryApi, SensorHeating, "Запрашивает данные", "Датчик")

Rel(AdministrationDb, TelemetryDb, "Replication")
Rel(ManageDeviceApi, TelemetryApi, "Запрашивает данные", "Для отчетов телеметрии")



@enduml

