@startuml
title "Диаграмма контекста приложения Smart Home To Be"

top to bottom direction

!include C4/C4_Context.puml

Person(User, "Пользователь")
Person(Specialist, "Специалист компании", "", person2)

System_Boundary(UserHome, "Дом пользователя") {
    System(SensorHeating, "Датчик отопления")
    System(SensorLight, "Датчик света на крыльце")
}

System_Boundary(SubdomainTelemetry, "Поддомен: Телеметрия") {
    System(TelemetryApi, "API")
    SystemDb(TelemetryDb, "DB")
    SystemQueue(TelemetryQueue, "Queue")
}

System_Boundary(SubdomainManageDevice, "Поддомен: Управление устройствами") {
    System(ManageDeviceApi, "API")
    SystemDb(ManageDeviceDb, "DB")
    SystemQueue(ManageDeviceQueue, "Queue")
}

System_Boundary(SubdomainAdministration, "Поддомен: Администрирование") {
    System(AdministrationApi, "API")
    SystemDb(AdministrationDb, "DB")
}


Rel(TelemetryApi, TelemetryDb, "Read\Write")
Rel(TelemetryApi, TelemetryQueue, "Add To")
Rel(TelemetryQueue, TelemetryDb, "Read")

Rel(SensorLight, TelemetryApi, "Отправляет данные")
Rel(TelemetryApi, SensorLight, "Запрашивает данные")

Rel(SensorHeating, TelemetryApi, "Отправляет данные")
Rel(TelemetryApi, SensorHeating, "Запрашивает данные")

Rel(ManageDeviceApi, ManageDeviceDb, "Read")
Rel(AdministrationApi, AdministrationDb, "Read\Write")
Rel(AdministrationDb, ManageDeviceDb, "Replication")
Rel(AdministrationDb, TelemetryDb, "Replication")

Rel(User, ManageDeviceApi, "Отправляет команду", "https")
Rel(ManageDeviceApi, ManageDeviceQueue, "Добавляет команду в очередь")
Rel(ManageDeviceQueue, SensorLight, "Отправляет команду")
Rel(ManageDeviceQueue, SensorHeating, "Отправляет команду")


Rel(Specialist, AdministrationApi, "Управляет данными")
Rel(User, AdministrationApi, "Управляет данными")

@enduml

